{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minnow",
  "version": "0.1.0",
  "identifier": "com.minnow.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Minnow",
      "decorations": false,
      "width": 1180,
      "height": 780,
      "minWidth": 520,
      "minHeight": 420,
      "backgroundColor": "#151515"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
